[Unit]
Description=SENAI - Grafico e Consulta de Cursos
After=network.target

[Service]
Type=simple
User=arielaram
Group=arielaram
WorkingDirectory=/home/arielaram/Documents/senai-cursos
ExecStart=/usr/local/bin/bun src/index.ts
Restart=always
RestartSec=5

# Environment variables
Environment=NODE_ENV=production
Environment=PORT=3010
Environment=HOST=0.0.0.0

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=senai-cursos

# Security hardening (optional)
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/home/arielaram/Documents/senai-cursos/data

[Install]
WantedBy=multi-user.target
